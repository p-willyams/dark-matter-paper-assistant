# Qdrant Cloud
QDRANT_CLUSTER_URL=https://xxxx-xxxx-xxxx.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=DarkRag

# Groq (LLM inference)
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# API
# Comma-separated list of allowed origins for CORS.
# Use "*" only for local development.
CORS_ALLOWED_ORIGINS=http://localhost:8501

# Frontend
# URL the Streamlit app uses to reach the API.
# Overridden automatically to http://backend:8000 when running via Docker Compose.
API_URL=http://localhost:8000